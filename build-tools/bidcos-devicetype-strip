#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

usage()
{
  echo "Usage: ${0##*/} <in.file> [-o out.file]" >&2
  exit 1
}

input=
output=
while (($#)); do
  case "$1" in
    -o)
      (($# >= 2)) || usage
      output=$2
      shift 2
      ;;
    -*)
      usage
      ;;
    *)
      [[ -z $input ]] || usage
      input=$1
      shift
      ;;
  esac
done

[[ -n $input ]] || usage
[[ -r $input ]] || {
  echo "${0##*/}: cannot read '$input'" >&2
  exit 1
}
[[ -n $output ]] || output=$input

output_dir=${output%/*}
if [[ $output_dir == "$output" ]]; then
  output_dir=.
fi
output_name=${output##*/}
[[ ! -d $output ]] || {
  echo "${0##*/}: output '$output' is a directory" >&2
  exit 1
}
temporary=$(mktemp "${output_dir}/.${output_name}.XXXXXX")
trap 'rm -f "$temporary"' EXIT

LC_ALL=C awk '
function error(message)
{
  print FILENAME ": " message > "/dev/stderr"
  failed = 1
  exit 2
}

function append_text(text)
{
  if (docu_depth == 0 && text ~ /[^[:space:]]/)
    result = result decoded_entities(text)
}

function hexadecimal(value,    digit, i, number)
{
  number = 0
  value = toupper(value)
  for (i = 1; i <= length(value); ++i) {
    digit = index("0123456789ABCDEF", substr(value, i, 1)) - 1
    if (digit < 0)
      return -1
    number = number * 16 + digit
  }
  return number
}

function decoded_entities(text,    entity, number, prefix, suffix)
{
  while (match(text, /&#[[:digit:]]+;/)) {
    entity = substr(text, RSTART, RLENGTH)
    number = substr(entity, 3, length(entity) - 3) + 0
    prefix = substr(text, 1, RSTART - 1)
    suffix = substr(text, RSTART + RLENGTH)
    text = prefix sprintf("%c", number) suffix
  }
  while (match(text, /&#[xX][[:xdigit:]]+;/)) {
    entity = substr(text, RSTART, RLENGTH)
    number = hexadecimal(substr(entity, 4, length(entity) - 4))
    prefix = substr(text, 1, RSTART - 1)
    suffix = substr(text, RSTART + RLENGTH)
    text = prefix sprintf("%c", number) suffix
  }
  return text
}

function normalized_tag(tag,    c, i, quote, space, normalized)
{
  normalized = ""
  quote = ""
  space = 0

  for (i = 1; i <= length(tag); ++i) {
    c = substr(tag, i, 1)
    if (quote != "") {
      if (c == quote) {
        normalized = normalized "\""
        quote = ""
      } else if (c == "\"") {
        normalized = normalized "&quot;"
      } else if (c == ">") {
        normalized = normalized "&gt;"
      } else {
        normalized = normalized c
      }
    } else if (c == "\"" || c == "\047") {
      if (space && normalized !~ /[<[:space:]=]$/)
        normalized = normalized " "
      space = 0
      quote = c
      normalized = normalized "\""
    } else if (c ~ /[[:space:]]/) {
      space = 1
    } else {
      if (space && c != ">" && c != "/" && c != "=" &&
          normalized !~ /[<[:space:]=]$/)
        normalized = normalized " "
      if (c == "=")
        sub(/[[:space:]]+$/, "", normalized)
      space = 0
      normalized = normalized c
    }
  }

  return decoded_entities(normalized)
}

function push(name)
{
  element_stack[++stack_depth] = name
  element_emitted[stack_depth] = 0
  element_content_start[stack_depth] = 0
}

function pop(name)
{
  if (stack_depth == 0 || element_stack[stack_depth] != name)
    error("mismatched closing element </" name ">")
  delete element_stack[stack_depth]
}

function handle_tag(tag,    body, closing, name, self_closing, was_docu)
{
  body = substr(tag, 2, length(tag) - 2)
  sub(/^[[:space:]]+/, "", body)
  sub(/[[:space:]]+$/, "", body)

  closing = substr(body, 1, 1) == "/"
  if (closing) {
    body = substr(body, 2)
    sub(/^[[:space:]]+/, "", body)
  }

  self_closing = !closing && body ~ /\/[[:space:]]*$/
  if (self_closing)
    sub(/\/[[:space:]]*$/, "", body)

  if (!match(body, /^[[:alpha:]_][[:alnum:]_.:-]*/))
    error("invalid element")
  name = substr(body, RSTART, RLENGTH)

  if (closing) {
    was_docu = docu_depth > 0
    pop(name)
    if (name == "docu")
      --docu_depth
    if (!was_docu) {
      if (element_emitted[stack_depth] &&
          length(result) == element_content_start[stack_depth])
        sub(/>$/, "/>", result)
      else
        result = result normalized_tag(tag)
    }
    delete element_emitted[stack_depth]
    delete element_content_start[stack_depth]
    --stack_depth
    return
  }

  if (!self_closing)
    push(name)

  if (name == "docu") {
    if (!self_closing)
      ++docu_depth
    return
  }

  if (docu_depth == 0) {
    result = result normalized_tag(tag)
    if (!self_closing) {
      element_emitted[stack_depth] = 1
      element_content_start[stack_depth] = length(result)
    }
  }
}

BEGIN {
  result = "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>"
}

{
  source = source $0 "\n"
}

END {
  if (failed)
    exit 2

  position = 1
  source_length = length(source)
  while (position <= source_length) {
    remaining = substr(source, position)

    if (substr(remaining, 1, 4) == "<!--") {
      end = index(remaining, "-->")
      if (!end)
        error("unterminated comment")
      position += end + 2
      continue
    }

    if (substr(remaining, 1, 2) == "<?") {
      end = index(remaining, "?>")
      if (!end)
        error("unterminated processing instruction")
      position += end + 1
      continue
    }

    if (substr(remaining, 1, 9) == "<![CDATA[") {
      end = index(remaining, "]]>")
      if (!end)
        error("unterminated CDATA section")
      text = substr(remaining, 10, end - 10)
      gsub(/&/, "\\&amp;", text)
      gsub(/</, "\\&lt;", text)
      append_text(text)
      position += end + 2
      continue
    }

    if (substr(remaining, 1, 2) == "<!")
      error("unsupported XML declaration")

    if (substr(remaining, 1, 1) == "<") {
      quote = ""
      end = 0
      for (i = 2; i <= length(remaining); ++i) {
        c = substr(remaining, i, 1)
        if (quote != "") {
          if (c == quote)
            quote = ""
        } else if (c == "\"" || c == "\047") {
          quote = c
        } else if (c == ">") {
          end = i
          break
        }
      }
      if (!end)
        error("unterminated element")
      handle_tag(substr(remaining, 1, end))
      position += end
      continue
    }

    end = index(remaining, "<")
    if (!end)
      end = length(remaining) + 1
    append_text(substr(remaining, 1, end - 1))
    position += end - 1
  }

  if (stack_depth != 0)
    error("unclosed element <" element_stack[stack_depth] ">")
  if (docu_depth != 0)
    error("unclosed documentation element")

  printf "%s", result
}
' "$input" > "$temporary"

[[ -s $temporary ]] || {
  echo "${0##*/}: generated empty output" >&2
  exit 1
}
mv -f "$temporary" "$output"
trap - EXIT
