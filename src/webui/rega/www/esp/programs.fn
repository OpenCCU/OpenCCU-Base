function ::DeleteSingleDestination()
{
  object oUser = dom.GetObject( system.GetSessionVar("sessionUserID") );
  if( (oUser.UserLevel() == iulAdmin) && (system.IsVar("did")) && (system.IsVar("sid")) )
  {
    object oTmp = dom.GetObject( system.GetVar("did") );
    if( oTmp )
    {
      boolean bDeleted = oTmp.DestDelSingle( system.GetVar("sid") );
      string sRemovedRuleParentID = "";
      if( bDeleted )
      {
        integer iElseDestID = oTmp.ID();
        Call("/esp/programs.fn::DeleteEmptyElseRule()");
      }
      if( sRemovedRuleParentID != "" )
      {
        Write( "removedRule:"#sRemovedRuleParentID );
      }
      else
      {
        Write( bDeleted );
      }
    }
  }
}

! Deletes the rule "rid" when it is the terminal ELSE rule of its parent
! rule and its destination iElseDestID has no activities left. Such a rule
! does nothing; the WebUI shows the ELSE placeholder instead and creates the
! rule again when an activity is added. On success the ID of the parent rule
! is returned in sRemovedRuleParentID, which the caller declares.
! ReGa evaluates all operands of &&, so object checks are nested.
function ::DeleteEmptyElseRule()
{
  object oUser = dom.GetObject( system.GetSessionVar("sessionUserID") );
  if( (oUser.UserLevel() == iulAdmin) && (system.IsVar("rid")) )
  {
    object oRule = dom.GetObject( system.GetVar("rid") );
    if( oRule )
    {
      object oDest = oRule.RuleDestination();
      if( oDest )
      {
        if( (oDest.ID() == iElseDestID) && (oDest.DestSingleCount() == 0) &&
            (!oRule.ElseIfFlag()) && (!oRule.RuleSubRule()) &&
            (oRule.RuleConditions().Count() == 0) )
        {
          object oParent = dom.GetObject( oRule.RuleParentID() );
          if( oParent )
          {
            if( oParent.IsTypeOf( OT_RULE ) )
            {
              object oSubRule = oParent.RuleSubRule();
              if( oSubRule )
              {
                if( oSubRule.ID() == oRule.ID() )
                {
                  if( oParent.RuleDelSubRule() )
                  {
                    sRemovedRuleParentID = oParent.ID().ToString();
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

